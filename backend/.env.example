# ============================================
# BALAUR SMS - Backend Configuration Template
# Copy to .env and fill with your values
# Location: /opt/balaur-sms/backend/.env.example
# ============================================

# ============================================
# APPLICATION
# ============================================
APP_NAME="Balaur SMS"
APP_VERSION="1.0.0"
DEBUG=False
ENVIRONMENT=production
CORS_ORIGINS=["https://balaur.university.edu"]
API_V1_PREFIX=/api/v1
DOCS_ENABLED=False

# ============================================
# DATABASE - PostgreSQL
# ============================================
DATABASE_URL=postgresql+asyncpg://balaur:CHANGE_ME@localhost:5432/balaur_sms
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# ============================================
# SECURITY - JWT & Encryption
# ============================================
SECRET_KEY=CHANGE_ME_GENERATE_WITH_SCRIPT
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
ENCRYPTION_KEY=CHANGE_ME_GENERATE_WITH_SCRIPT
BCRYPT_ROUNDS=12

# ============================================
# LDAP / ACTIVE DIRECTORY
# ============================================
LDAP_ENABLED=True
LDAP_SERVER=ldap://ldap.university.edu
LDAP_PORT=389
LDAP_USE_SSL=False
LDAP_USE_TLS=True
LDAP_BIND_DN=cn=service-account,ou=services,dc=university,dc=edu
LDAP_BIND_PASSWORD=CHANGE_ME
LDAP_BASE_DN=dc=university,dc=edu
LDAP_USER_SEARCH_BASE=ou=people,dc=university,dc=edu
LDAP_USER_SEARCH_FILTER=(uid={username})
LDAP_USER_OBJECT_CLASS=inetOrgPerson
LDAP_ATTR_USERNAME=uid
LDAP_ATTR_EMAIL=mail
LDAP_ATTR_FIRST_NAME=givenName
LDAP_ATTR_LAST_NAME=sn
LDAP_ATTR_MEMBER_OF=memberOf
LDAP_GROUP_ADMIN=cn=balaur-admins,ou=groups,dc=university,dc=edu
LDAP_GROUP_MANAGER=cn=balaur-managers,ou=groups,dc=university,dc=edu
LDAP_GROUP_USER=cn=balaur-users,ou=groups,dc=university,dc=edu
LDAP_TIMEOUT=10

# ============================================
# FTP / FTPS CONFIGURATION
# ============================================
FTP_HOST=localhost
FTP_PORT=21
FTP_USER=balaur
FTP_PASSWORD=CHANGE_ME
FTP_USE_TLS=True
FTP_TLS_IMPLICIT=False
FTP_BASE_PATH=/srv/ftp/balaur
FTP_INBOX_PENDING=/srv/ftp/balaur/inbox/pending
FTP_INBOX_PROCESSING=/srv/ftp/balaur/inbox/processing
FTP_REPOSITORY=/srv/ftp/balaur/repository
FTP_QUARANTINE=/srv/ftp/balaur/quarantine
FTP_TIMEOUT=30
FTP_PASSIVE_MODE=True

# ============================================
# FILE HANDLING
# ============================================
ALLOWED_INSTALLER_EXTENSIONS=[".exe",".msi",".dmg",".pkg",".deb",".rpm",".AppImage",".zip",".tar.gz"]
ALLOWED_DOC_EXTENSIONS=[".pdf",".docx",".txt",".md"]
MAX_FILE_SIZE=10737418240
WEB_UPLOAD_MAX_SIZE=1073741824
HASH_ALGORITHM=sha256

# ============================================
# FTP WATCHER SERVICE
# ============================================
WATCHER_INTERVAL=300
WATCHER_ENABLED=True
WATCHER_MAX_RETRIES=3

# ============================================
# AUDIT & LOGGING
# ============================================
LOG_LEVEL=INFO
LOG_FILE_PATH=/var/log/balaur/backend/app.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=10
AUDIT_LOG_RETENTION_DAYS=365

# ============================================
# PAGINATION
# Default page size for paginated endpoints
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# ============================================
# RATE LIMITING (Optional)
# ============================================
RATE_LIMIT_ENABLED=False
RATE_LIMIT_PER_MINUTE=60

# ============================================
# EMAIL NOTIFICATIONS (Future)
# ============================================
EMAIL_ENABLED=False

# ============================================
# REDIS CACHE (Future)
# ============================================
REDIS_ENABLED=False

# ============================================
# DEVELOPMENT / DEBUG
# ============================================
SQL_ECHO=False
RELOAD=False

# ============================================
# BACKUP
# ============================================
BACKUP_DIR=/var/backups/balaur
BACKUP_RETENTION_DAYS=30